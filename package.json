{
  "name": "bom-gosto-web-app",
  "version": "0.0.1",
  "description": "Sistema de gerenciamento para a Confeitaria Bom Gosto.",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "docker:up": "docker compose up --build",
    "docker:up:d": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:down:v": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "db:migrate": "docker compose exec backend python manage.py migrate",
    "db:makemigrations": "docker compose exec backend python manage.py makemigrations",
    "test:backend": "docker compose exec backend pytest",
    "start:frontend": "npm --prefix apps/frontend run start",
    "build:frontend": "npm --prefix apps/frontend run build",
    "test:frontend": "npm --prefix apps/frontend run test",
    "generate:types": "openapi-typescript http://localhost:8000/api/schema/ -o apps/frontend/src/app/core/models/api.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SouOWendel/bom-gosto-web-app.git"
  },
  "keywords": [
    "angular",
    "django",
    "postgresql",
    "monorepo",
    "pwa"
  ],
  "author": "Wendel Henrique Lima de Souza",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/SouOWendel/bom-gosto-web-app/issues"
  },
  "homepage": "https://github.com/SouOWendel/bom-gosto-web-app#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "apps/frontend/**/*.{js,ts,html,css,scss,json,md}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
