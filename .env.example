POSTGRES_DB=db_confeitaria
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Origens do frontend autorizadas (CORS/CSRF), separadas por vírgula
DJANGO_FRONTEND_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Tentativas de login por IP (formato do DRF: 5/min, 20/hour...)
LOGIN_THROTTLE_RATE=5/min
# Expõe o /admin/ do Django (1 = sim); fica desligado por padrão
DJANGO_ADMIN_ENABLED=0
